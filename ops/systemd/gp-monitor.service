[Unit]
Description=GammaPin live monitor (Node C)
After=network-online.target

[Service]
Type=simple
User=gammapin
WorkingDirectory=/opt/gammapin
# Follows today's node segments under [merge] inbox and serves /ws on [monitor] bind.
ExecStart=/opt/gammapin/bin/gp-monitor --config /etc/gammapin/gammapin.toml live
Restart=on-failure
# The timer starts it before the open; this stops it after the close, so the next day's
# run follows the new date's directories.
RuntimeMaxSec=7h
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
