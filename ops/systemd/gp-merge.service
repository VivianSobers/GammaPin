[Unit]
Description=GammaPin merge + compress (Node C, after close)
After=network-online.target

[Service]
Type=oneshot
User=gammapin
WorkingDirectory=/opt/gammapin
# Exit 3: merged, but some window was missed by every node (see coverage.md).
ExecStart=/opt/gammapin/bin/gp-merge --config /etc/gammapin/gammapin.toml --date today
