[Unit]
Description=GammaPin capture (Upstox V3 -> GPL1)
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=gammapin
WorkingDirectory=/opt/gammapin
ExecStart=/opt/gammapin/bin/gp-capture --config /etc/gammapin/gammapin.toml
Restart=always
RestartSec=1
# Capture window is 09:00-15:40 IST; the timer starts it, this caps it.
RuntimeMaxSec=7h
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
